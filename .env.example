# Copy this file to ".env" and fill in your own values.
# ".env" is ignored by git, so your key is never uploaded.

# AI provider for the chat advisor. Leave GROQ_API_KEY empty to run in scripted (no-AI) mode.
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=

# Date the app treats as "today" for document checks (set by the case README)
APP_TODAY=2026-07-15

# Saved applications (so progress survives a restart). Each one is encrypted with this key; keep it secret.
# Make one with: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Leave empty to keep applications in memory only (lost when the server restarts).
APP_STATE_KEY=

# One-time codes for the mobile number. "demo" shows the code on screen (no SMS provider in the prototype).
OTP_MODE=demo

# Staff back office at /#/office (statistics, customers, conversion predictor). Leave empty to switch it off.
BACKOFFICE_KEY=
