# Copy this file to ".env" and fill in your own values.
# ".env" is ignored by git, so your key is never uploaded.

# AI provider for the chat advisor. Leave GROQ_API_KEY empty to run in scripted (no-AI) mode.
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=

# Date the app treats as "today" for document checks (set by the case README)
APP_TODAY=2026-07-15

# Saved applications (so progress survives a restart). Each one is encrypted with this key; keep it secret.
# Make one with: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Leave empty to keep applications in memory only (lost when the server restarts).
APP_STATE_KEY=

# One-time codes for the mobile number. "demo" shows the code on screen (for judging the prototype); "sms" texts it
# through SMS_PROVIDER and never shows it. If "sms" is not fully set up, sending fails (it never falls back to demo).
OTP_MODE=demo
# SMS_PROVIDER=msg91   (India, DLT-registered template)   or   twilio   (quick trial)
SMS_PROVIDER=
# MSG91: msg91.com -> API -> Auth key; and the ID of your DLT-approved OTP template (it must contain ##OTP##)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Twilio: console.twilio.com -> Account SID + Auth token; TWILIO_FROM = your Twilio number (+1...) or Messaging Service SID (MG...)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Staff back office at /#/office (statistics, customers, conversion predictor). Leave empty to switch it off.
BACKOFFICE_KEY=
# Channel partners (codes in backend/app/partners.json) sign in to the same back office with their own key and see only
# the applications that came through their link (/?ref=RAJ01). Format: CODE=key;CODE=key
PARTNER_KEYS=
# How long data is kept without activity: leads (hours) and accepted orders (days)
RETENTION_HOURS=72
ORDER_RETENTION_DAYS=365
